<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only because the store uses DPAPI. No UI. The Graph clients take an HttpClient
         and a token delegate, so tests run them against a fake handler with no network. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>rNotice.Core</RootNamespace>
    <AssemblyName>rNotice.Core</AssemblyName>
    <Company>Bravura Security</Company>
    <Product>rNotice</Product>
    <Description>Item model, rules, scheduling and local store for rNotice.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="rNotice.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
