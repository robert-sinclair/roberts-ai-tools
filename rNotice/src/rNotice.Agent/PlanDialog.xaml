<Window x:Class="rNotice.Agent.PlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plan" Width="940" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="18,14">
        <TextBlock x:Name="ItemTitle" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <!-- Planning several items together: the block's title, and what goes in its description. -->
        <StackPanel x:Name="GroupPanel" DockPanel.Dock="Top" Visibility="Collapsed">
            <DockPanel>
                <TextBlock Text="Title" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox x:Name="TitleBox" FontSize="15" Padding="4,2" />
            </DockPanel>
            <TextBlock Text="In the description:" Opacity="0.75" Margin="0,8,0,2" />
            <TextBlock x:Name="GroupList" FontSize="12" TextWrapping="Wrap" MaxHeight="140" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock x:Name="ItemMeta" DockPanel.Dock="Top" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,12" />

        <!-- Commit row: what's selected, and the buttons. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="80"
                    HorizontalContentAlignment="Center" Margin="8,0,0,0" />
            <Button x:Name="PlanSelected" DockPanel.Dock="Right" IsDefault="True" Margin="8,0,0,0"
                    HorizontalContentAlignment="Center" FontWeight="SemiBold" Padding="16,5" Click="OnPlanSelected" />
            <Button x:Name="NoTime" DockPanel.Dock="Left" Margin="0" Click="OnNoTime" />
            <CheckBox x:Name="OnCalendar" Content="Put it on my Outlook calendar" VerticalAlignment="Center" Margin="16,0,0,0"
                      ToolTip="A tentative event, tagged rNotice, no attendees. Moves when you re-plan; removed when it's done." />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: duration and suggestions. -->
            <StackPanel Grid.Column="0">
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="How long?" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="Duration" Width="120" HorizontalAlignment="Left" SelectionChanged="OnDurationChanged" />
                </DockPanel>

                <TextBlock x:Name="SlotsHeading" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" />
                <TextBlock x:Name="SlotsNote" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
                <StackPanel x:Name="Slots" />

                <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="A suggestion shows on the day view. Or pick your own time there: click a quarter hour, drag for longer, Shift+click to extend." />
                <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="With a time, rNotice reminds you and won't offer that slot again. On your Outlook calendar, rNotice alerts 5 minutes before and Outlook reminds you at the start." />
            </StackPanel>

            <!-- Right: the chosen day, quarter hour by quarter hour. -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Left" Content="◀" Padding="10,2" Margin="0" Click="OnPrevDay"
                            HorizontalContentAlignment="Center" ToolTip="Previous working day" />
                    <Button DockPanel.Dock="Right" Content="▶" Padding="10,2" Margin="0" Click="OnNextDay"
                            HorizontalContentAlignment="Center" ToolTip="Next working day" />
                    <TextBlock x:Name="DayLabel" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Docked items must come before the filler: the last child of a DockPanel takes
                     the remaining space, so the grid goes last to get the full width. -->
                <TextBlock x:Name="Legend" DockPanel.Dock="Bottom" FontSize="11" Opacity="0.7" Margin="0,6,0,0" TextWrapping="Wrap" />

                <ScrollViewer x:Name="DayScroll" Height="520" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="DayCells" Background="Transparent"
                          MouseLeftButtonDown="OnCellsDown" MouseMove="OnCellsMove" MouseLeftButtonUp="OnCellsUp" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
