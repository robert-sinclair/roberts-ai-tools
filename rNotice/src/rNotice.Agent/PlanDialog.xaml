<Window x:Class="rNotice.Agent.PlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plan" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14">
        <TextBlock x:Name="ItemTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="ItemMeta" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,12" />

        <TextBlock Text="When will you do it?" FontWeight="SemiBold" Margin="0,0,0,6" />

        <Button x:Name="NoTime" IsDefault="True" Click="OnNoTime" />
        <Button x:Name="InOneHour" Click="OnPreset" />
        <Button x:Name="InThreeHours" Click="OnPreset" />
        <Button x:Name="TomorrowMorning" Click="OnPreset" />

        <DockPanel Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="Plan for this time" Margin="8,0,0,0" Click="OnCustom" />
            <TextBox x:Name="CustomTime" DockPanel.Dock="Right" Width="56" Margin="8,0,0,0"
                     VerticalContentAlignment="Center" ToolTip="Local time, 24-hour (HH:mm)" />
            <DatePicker x:Name="CustomDate" />
        </DockPanel>
        <TextBlock x:Name="Error" Foreground="#D13438" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />

        <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="With a time, rNotice reminds you then. Nothing goes on your calendar yet — that's promotion, a later build." />

        <Button Content="Cancel" IsCancel="True" HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                MinWidth="80" Margin="0,12,0,0" />
    </StackPanel>
</Window>
