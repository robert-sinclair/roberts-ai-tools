<Window x:Class="rNotice.Agent.PlanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plan" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14">
        <TextBlock x:Name="ItemTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="ItemMeta" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,12" />

        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="How long?" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="Duration" Width="120" HorizontalAlignment="Left" SelectionChanged="OnDurationChanged" />
        </DockPanel>

        <TextBlock x:Name="SlotsHeading" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" />
        <TextBlock x:Name="SlotsNote" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
        <StackPanel x:Name="Slots" />

        <TextBlock Text="Or pick a time" FontWeight="SemiBold" Margin="0,10,0,6" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Plan for this time" Margin="8,0,0,0" Click="OnCustom" />
            <TextBox x:Name="CustomTime" DockPanel.Dock="Right" Width="56" Margin="8,0,0,0"
                     VerticalContentAlignment="Center" ToolTip="Local time, 24-hour (HH:mm)" />
            <DatePicker x:Name="CustomDate" />
        </DockPanel>
        <TextBlock x:Name="Error" Foreground="#D13438" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />

        <Button x:Name="NoTime" Margin="0,12,0,0" Click="OnNoTime" />

        <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="With a time, rNotice reminds you then and won't offer that slot again. Nothing goes on your calendar yet — that's promotion, a later build." />

        <Button Content="Cancel" IsCancel="True" HorizontalAlignment="Right" HorizontalContentAlignment="Center"
                MinWidth="80" Margin="0,12,0,0" />
    </StackPanel>
</Window>
