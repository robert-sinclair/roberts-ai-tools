<Window x:Class="rNotice.Agent.QueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="rNotice" Width="1100" Height="680" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <DataTemplate x:Key="ItemTemplate">
            <Grid Margin="2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Badge" CornerRadius="3" Padding="5,1" Margin="0,1,8,0" VerticalAlignment="Top" Background="#8A8A8A">
                    <TextBlock Text="{Binding Priority}" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Meta}" Opacity="0.75" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Snoozed}" Opacity="0.75" FontSize="12" FontStyle="Italic"
                               Visibility="{Binding IsSnoozed, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="P1">
                    <Setter TargetName="Badge" Property="Background" Value="#D13438" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="P2">
                    <Setter TargetName="Badge" Property="Background" Value="#E08B1E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="P4">
                    <Setter TargetName="Badge" Property="Background" Value="#B8B8B8" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style TargetType="ListBox">
            <Setter Property="ItemTemplate" Value="{StaticResource ItemTemplate}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Opacity="0.75" Margin="0,0,0,10" TextWrapping="Wrap" />

        <TextBlock DockPanel.Dock="Bottom" Opacity="0.75" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="P plan · D dismiss · C complete · S snooze · Enter open source · ←/→ switch column · F5 refresh · Esc hide" />

        <Border x:Name="Detail" DockPanel.Dock="Bottom" BorderThickness="1" Padding="10" Margin="0,10,0,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <StackPanel>
                <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailMeta" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock x:Name="DetailReason" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock x:Name="DetailSnippet" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="80" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock x:Name="IntakeHeader" DockPanel.Dock="Top" Style="{StaticResource Header}" Text="Intake" />
                <ListBox x:Name="IntakeList" SelectionChanged="OnSelectionChanged" GotKeyboardFocus="OnListFocus" />
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock x:Name="PlannedHeader" DockPanel.Dock="Top" Style="{StaticResource Header}" Text="Planned" />
                <ListBox x:Name="PlannedList" SelectionChanged="OnSelectionChanged" GotKeyboardFocus="OnListFocus" />
            </DockPanel>
            <DockPanel Grid.Column="4">
                <TextBlock x:Name="DoneHeader" DockPanel.Dock="Top" Style="{StaticResource Header}" Text="Done" />
                <ListBox x:Name="DoneList" SelectionChanged="OnSelectionChanged" GotKeyboardFocus="OnListFocus" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
