<Window x:Class="rNotice.Agent.QueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="rNotice" Width="1100" Height="820" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <DataTemplate x:Key="ItemTemplate">
            <Grid Margin="2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Badge" CornerRadius="3" Padding="5,1" Margin="0,1,8,0" MinWidth="38"
                        VerticalAlignment="Top" Background="#8A8A8A">
                    <TextBlock Text="{Binding Badge}" Foreground="White" FontWeight="SemiBold" FontSize="11"
                               HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="ItemTitle" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Meta}" Opacity="0.75" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Snoozed}" Opacity="0.75" FontSize="12" FontStyle="Italic"
                               Visibility="{Binding IsSnoozed, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="P1">
                    <Setter TargetName="Badge" Property="Background" Value="#D13438" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="P2">
                    <Setter TargetName="Badge" Property="Background" Value="#E08B1E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="P4">
                    <Setter TargetName="Badge" Property="Background" Value="#B8B8B8" />
                </DataTrigger>
                <!-- Last, so it wins: a meeting's badge is its start time, not a priority. -->
                <DataTrigger Binding="{Binding IsMeeting}" Value="True">
                    <Setter TargetName="Badge" Property="Background" Value="#2B6CB0" />
                </DataTrigger>
                <!-- Mail read in Outlook drops to normal weight, as Outlook shows it. Noted, not closed. -->
                <DataTrigger Binding="{Binding Item.IsRead}" Value="True">
                    <Setter TargetName="ItemTitle" Property="FontWeight" Value="Normal" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <GroupStyle x:Key="ByDay">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <Border BorderThickness="0,0,0,1" Margin="0,10,0,2" Padding="2,0,0,2"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="{Binding Name, Mode=OneWay}" />
                            <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat='· {0}'}" Foreground="Gray" />
                        </TextBlock>
                    </Border>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>

        <Style TargetType="ListBox">
            <Setter Property="ItemTemplate" Value="{StaticResource ItemTemplate}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <!-- Footer: keys left, who you are right; source status underneath. -->
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Opacity="0.75" TextWrapping="Wrap"
                       Text="Right-click an item for options · drag to Done to complete, Intake → Planned to plan · P plan · C mark done · Del dismiss · S snooze · Enter open · ←/→ column · F5 refresh · Esc hide" />
            <TextBlock x:Name="SignedInText" Grid.Column="1" Opacity="0.75" Margin="16,0,0,0" />
            <TextBlock x:Name="SourcesText" Grid.Row="1" Opacity="0.6" FontSize="12"
                       Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="NextRefreshText" Grid.Row="1" Grid.Column="1" Opacity="0.6" FontSize="12"
                       Margin="16,4,0,0" HorizontalAlignment="Right" ToolTip="F5 to refresh now" />
        </Grid>

        <!-- Lists on top, detail below, with a splitter between them you can drag. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="260" MinHeight="90" />
            </Grid.RowDefinitions>

        <GridSplitter Grid.Row="1" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent"
                      Cursor="SizeNS" ToolTip="Drag to resize the detail pane" />

        <Border x:Name="Detail" Grid.Row="2" BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10">
                <StackPanel>
                    <TextBlock x:Name="DetailPlaceholder" Opacity="0.6" Text="Select an item to see it here." />
                    <StackPanel x:Name="DetailBody">
                        <!-- Read-only text boxes that look like plain text, so the title, the line
                             and the reason can be selected and copied like the excerpt below. -->
                        <TextBox x:Name="DetailTitle" Style="{StaticResource SelectableText}" FontWeight="SemiBold" FontSize="16" />
                        <TextBox x:Name="DetailMeta" Style="{StaticResource SelectableText}" Opacity="0.75" Margin="0,4,0,0" />
                        <TextBox x:Name="DetailReason" Style="{StaticResource SelectableText}" FontStyle="Italic" Opacity="0.85" Margin="0,4,0,0" />
                        <!-- Read-only text box, so the excerpt can be selected and copied. -->
                        <TextBox x:Name="DetailSnippet" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                 Background="Transparent" Padding="0" Margin="0,10,0,0" FontSize="13" />
                        <TextBlock x:Name="DetailOpenHint" Opacity="0.6" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock x:Name="IntakeHeader" DockPanel.Dock="Top" Style="{StaticResource Header}" Text="Intake" />
                <ListBox x:Name="IntakeList" SelectionChanged="OnSelectionChanged" GotKeyboardFocus="OnListFocus"
                         AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop"
                         PreviewMouseLeftButtonDown="OnMouseDown" PreviewMouseMove="OnMouseMove"
                         ContextMenuOpening="OnContextMenuOpening">
                    <ListBox.ContextMenu><ContextMenu /></ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock x:Name="PlannedHeader" DockPanel.Dock="Top" Style="{StaticResource Header}" Text="Planned" />
                <ListBox x:Name="PlannedList" SelectionChanged="OnSelectionChanged" GotKeyboardFocus="OnListFocus"
                         AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop"
                         PreviewMouseLeftButtonDown="OnMouseDown" PreviewMouseMove="OnMouseMove"
                         ContextMenuOpening="OnContextMenuOpening">
                    <ListBox.ContextMenu><ContextMenu /></ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
            <DockPanel Grid.Column="4">
                <TextBlock x:Name="DoneHeader" DockPanel.Dock="Top" Style="{StaticResource Header}" Text="Done" />
                <ListBox x:Name="DoneList" SelectionChanged="OnSelectionChanged" GotKeyboardFocus="OnListFocus"
                         AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop"
                         PreviewMouseLeftButtonDown="OnMouseDown" PreviewMouseMove="OnMouseMove"
                         ContextMenuOpening="OnContextMenuOpening">
                    <ListBox.ContextMenu><ContextMenu /></ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Grid>
        </Grid>
    </DockPanel>
</Window>
