<Window x:Class="rNotice.Agent.QueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="rNotice" Width="1320" Height="860" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <DataTemplate x:Key="ItemTemplate">
            <Grid Margin="2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Badge" CornerRadius="3" Padding="5,1" Margin="0,1,8,0" MinWidth="38"
                        VerticalAlignment="Top" Background="#8A8A8A">
                    <TextBlock Text="{Binding Badge}" Foreground="White" FontWeight="SemiBold" FontSize="11"
                               HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="ItemTitle" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasPlainTitle, Converter={StaticResource Visible}}" />
                    <!-- A case in the title: the case number itself is the link to Salesforce. -->
                    <TextBlock x:Name="ItemTitleWithCase" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasCaseInTitle, Converter={StaticResource Visible}}"><Run Text="{Binding TitleLead, Mode=OneWay}" /><Hyperlink NavigateUri="{Binding Item.CaseUrl}" RequestNavigate="OnCaseLink" ToolTip="Open the case in Salesforce"><Run Text="{Binding CaseNumber, Mode=OneWay}" /></Hyperlink><Run Text="{Binding TitleTail, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="{Binding Meta}" Opacity="0.75" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <!-- rNotice's note. For a clash, the meeting's name is a link that shows the meeting. -->
                    <TextBlock Foreground="#B5651D" FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                               Visibility="{Binding HasNoteLink, Converter={StaticResource Visible}}">
                        <Run Text="{Binding NoteLead, Mode=OneWay}" /><Hyperlink Click="OnNoteLink"><Run Text="{Binding NoteLinkText, Mode=OneWay}" /></Hyperlink>
                    </TextBlock>
                    <TextBlock Text="{Binding Item.Note}" Foreground="#B5651D" FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                               Visibility="{Binding HasPlainNote, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding Snoozed}" Opacity="0.75" FontSize="12" FontStyle="Italic"
                               Visibility="{Binding IsSnoozed, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="P1">
                    <Setter TargetName="Badge" Property="Background" Value="#D13438" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="P2">
                    <Setter TargetName="Badge" Property="Background" Value="#E08B1E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="P4">
                    <Setter TargetName="Badge" Property="Background" Value="#B8B8B8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMeeting}" Value="True">
                    <Setter TargetName="Badge" Property="Background" Value="#2B6CB0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Item.IsRead}" Value="True">
                    <Setter TargetName="ItemTitle" Property="FontWeight" Value="Normal" />
                    <Setter TargetName="ItemTitleWithCase" Property="FontWeight" Value="Normal" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <GroupStyle x:Key="ByDay">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <Border BorderThickness="0,0,0,1" Margin="0,10,0,2" Padding="2,0,0,2"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="{Binding Name, Mode=OneWay}" />
                            <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat='· {0}'}" Foreground="Gray" />
                        </TextBlock>
                    </Border>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>

        <Style TargetType="ListBox">
            <Setter Property="ItemTemplate" Value="{StaticResource ItemTemplate}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <!-- Read-only rich text: selectable like the rest, and able to carry an inline link. -->
        <Style x:Key="SelectableRich" TargetType="RichTextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsDocumentEnabled" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <!-- Footer: keys left, who you are right; source status underneath. -->
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Opacity="0.75" TextWrapping="Wrap"
                       Text="Right-click for options · drag an item onto a time in the calendar to plan it, onto Done to finish it · P plan · C mark done · Del dismiss · S snooze · Enter open · ←/→ calendar day · F5 refresh · Esc hide" />
            <TextBlock x:Name="SignedInText" Grid.Column="1" Opacity="0.75" Margin="16,0,0,0" />
            <TextBlock x:Name="SourcesText" Grid.Row="1" Opacity="0.6" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="NextRefreshText" Grid.Row="1" Grid.Column="1" Opacity="0.6" FontSize="12"
                       Margin="16,4,0,0" HorizontalAlignment="Right" ToolTip="F5 to refresh now" />
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="420" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Left: Intake (and Done) on the top third, the selected item below. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="120" />
                </Grid.RowDefinitions>

                <TabControl x:Name="Tabs" Grid.Row="0" SelectionChanged="OnTabChanged">
                    <TabItem>
                        <TabItem.Header>
                            <TextBlock x:Name="IntakeHeader" Text="Intake" FontWeight="SemiBold" />
                        </TabItem.Header>
                        <ListBox x:Name="IntakeList" SelectionChanged="OnSelectionChanged" GotKeyboardFocus="OnListFocus"
                                 PreviewMouseLeftButtonDown="OnMouseDown" PreviewMouseMove="OnMouseMove"
                                 ContextMenuOpening="OnListContextMenu">
                            <ListBox.ContextMenu><ContextMenu /></ListBox.ContextMenu>
                        </ListBox>
                    </TabItem>
                    <!-- The Done tab is also a drop target: drag an item onto its header to finish it. -->
                    <TabItem x:Name="DoneTab" AllowDrop="True" DragOver="OnDoneDragOver" DragLeave="OnDoneDragLeave" Drop="OnDoneDrop">
                        <TabItem.Header>
                            <TextBlock x:Name="DoneHeader" Text="Done" FontWeight="SemiBold" />
                        </TabItem.Header>
                        <ListBox x:Name="DoneList" SelectionChanged="OnSelectionChanged" GotKeyboardFocus="OnListFocus"
                                 PreviewMouseLeftButtonDown="OnMouseDown" PreviewMouseMove="OnMouseMove"
                                 ContextMenuOpening="OnListContextMenu">
                            <ListBox.ContextMenu><ContextMenu /></ListBox.ContextMenu>
                        </ListBox>
                    </TabItem>
                </TabControl>

                <GridSplitter Grid.Row="1" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent"
                              Cursor="SizeNS" ToolTip="Drag to resize" />

                <Border x:Name="Detail" Grid.Row="2" BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10">
                        <StackPanel>
                            <TextBlock x:Name="DetailPlaceholder" Opacity="0.6" Text="Select an item to see it here." />
                            <StackPanel x:Name="DetailBody">
                                <RichTextBox x:Name="DetailTitle" Style="{StaticResource SelectableRich}" FontWeight="SemiBold" FontSize="16"
                                             MouseDoubleClick="OnTitleDoubleClick" ToolTip="Double-click or F2 to edit the title" />
                                <TextBox x:Name="TitleEditor" FontWeight="SemiBold" FontSize="16" Visibility="Collapsed"
                                         TextWrapping="Wrap" AcceptsReturn="False" Padding="2"
                                         KeyDown="OnTitleEditorKey" LostKeyboardFocus="OnTitleEditorLostFocus"
                                         ToolTip="Enter saves, Esc cancels. Clear it to go back to the original title." />
                                <TextBox x:Name="DetailMeta" Style="{StaticResource SelectableText}" Opacity="0.75" Margin="0,4,0,0" />
                                <RichTextBox x:Name="DetailNote" Style="{StaticResource SelectableRich}" Foreground="#B5651D" FontStyle="Italic" Margin="0,4,0,0" />
                                <TextBox x:Name="DetailReason" Style="{StaticResource SelectableText}" FontStyle="Italic" Opacity="0.85" Margin="0,4,0,0" />
                                <RichTextBox x:Name="DetailSnippet" Style="{StaticResource SelectableRich}" Margin="0,10,0,0" FontSize="13" />
                                <TextBlock x:Name="DetailOpenHint" Opacity="0.6" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Right: Planned, as a calendar day. -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock x:Name="PlannedHeader" DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" Text="Planned" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="◀" Padding="10,2" Click="OnPrevDay" ToolTip="Previous working day (←)" />
                        <Button Content="Today" Padding="10,2" Margin="4,0" Click="OnToday" />
                        <Button Content="▶" Padding="10,2" Click="OnNextDay" ToolTip="Next working day (→)" />
                    </StackPanel>
                    <TextBlock x:Name="DayLabel" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DockPanel>

                <!-- All-day events, and plans with no time. -->
                <WrapPanel x:Name="TopStrip" DockPanel.Dock="Top" Margin="52,0,0,6" />

                <Border BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                    <ScrollViewer x:Name="CalScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas x:Name="TimeLabels" Grid.Column="0" />
                            <Canvas x:Name="CalCanvas" Grid.Column="1" Background="Transparent" ClipToBounds="True" AllowDrop="True"
                                    SizeChanged="OnCalendarResized" DragOver="OnCalendarDragOver" DragLeave="OnCalendarDragLeave"
                                    Drop="OnCalendarDrop" MouseLeftButtonDown="OnCalendarBackgroundClick" />
                        </Grid>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
