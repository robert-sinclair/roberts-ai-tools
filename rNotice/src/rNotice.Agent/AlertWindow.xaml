<Window x:Class="rNotice.Agent.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:rNotice.Agent"
        Title="rNotice" Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        BorderBrush="#2B6CB0" BorderThickness="2">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <Style x:Key="TaskButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="MinWidth" Value="72" />
        </Style>
        <Style x:Key="MeetingButton" TargetType="Button">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="28,10" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinWidth" Value="140" />
        </Style>
        <Style x:Key="JoinButton" TargetType="Button" BasedOn="{StaticResource MeetingButton}">
            <Setter Property="Background" Value="#2B6CB0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#2B6CB0" />
        </Style>

        <!-- A meeting starting now: big, a live countdown, Join first. -->
        <DataTemplate x:Key="MeetingTemplate">
            <StackPanel Margin="0,4,0,18">
                <TextBlock Text="{Binding Countdown}" FontSize="40" FontWeight="SemiBold" Foreground="#2B6CB0" />
                <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding MeetingLine}" FontSize="17" Opacity="0.8" TextWrapping="Wrap" Margin="0,8,0,0" />
                <WrapPanel Margin="0,24,0,0">
                    <Button Content="Join" Tag="{Binding Id}" Click="OnJoin" Style="{StaticResource JoinButton}"
                            Visibility="{Binding HasJoin, Converter={StaticResource Visible}}" />
                    <Button Content="{Binding OpenLabel}" Tag="{Binding Id}" Click="OnOpen" Style="{StaticResource MeetingButton}"
                            Visibility="{Binding HasSource, Converter={StaticResource Visible}}" />
                    <Button Content="Mark done" Tag="{Binding Id}" Click="OnDone" Style="{StaticResource MeetingButton}" />
                    <Button Tag="{Binding Id}" Click="OnSnoozeMeeting" Loaded="OnSnoozeMeetingLoaded" Style="{StaticResource MeetingButton}"
                            ToolTip="Hide this and the dim; both come back just before the meeting starts"
                            Visibility="{Binding CanSnoozeMeeting, Converter={StaticResource Visible}}" />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Anything else: compact. -->
        <DataTemplate x:Key="TaskTemplate">
            <Border BorderThickness="0,0,0,1" Padding="0,8,0,8"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Meta}" Opacity="0.8" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Reason}" FontStyle="Italic" Opacity="0.8" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="60"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasSnippet, Converter={StaticResource Visible}}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Plan…" Tag="{Binding Id}" Click="OnPlan" Style="{StaticResource TaskButton}"
                                Visibility="{Binding CanPlan, Converter={StaticResource Visible}}" />
                        <Button Content="Mark done" Tag="{Binding Id}" Click="OnDone" Style="{StaticResource TaskButton}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,6"
                                    Visibility="{Binding CanSnooze, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding RebookLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox Tag="{Binding Id}" MinWidth="250" Loaded="OnRebookLoaded" DropDownOpened="OnRebookOpened"
                                      SelectionChanged="OnRebookChosen"
                                      ToolTip="Next free slot, an hour or more later, or first thing next working day: 30 min or 1 h, clear of meetings and other plans" />
                        </StackPanel>
                        <Button Content="{Binding OpenLabel}" Tag="{Binding Id}" Click="OnOpen" Style="{StaticResource TaskButton}"
                                Visibility="{Binding HasSource, Converter={StaticResource Visible}}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <local:AlertTemplateSelector x:Key="Selector"
                                     Meeting="{StaticResource MeetingTemplate}"
                                     Task="{StaticResource TaskTemplate}" />
    </Window.Resources>

    <DockPanel x:Name="Root" Margin="18,14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Close" Margin="0" Padding="12,4" Click="OnClose"
                    ToolTip="Leave these in the queue" />
            <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemsList" ItemTemplateSelector="{StaticResource Selector}" />
        </ScrollViewer>
    </DockPanel>
</Window>
