<Window x:Class="rNotice.Agent.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="rNotice" Width="560" SizeToContent="Height" MaxHeight="760"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        BorderBrush="#2B6CB0" BorderThickness="2">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="MinWidth" Value="72" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="18,14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Close" Margin="0" Click="OnClose"
                    ToolTip="Leave these in the queue" />
            <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0,0,0,1" Padding="0,8,0,8"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Meta}" Opacity="0.8" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Reason}" FontStyle="Italic" Opacity="0.8" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="60"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasSnippet, Converter={StaticResource Visible}}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Join" Tag="{Binding Id}" Click="OnJoin" FontWeight="SemiBold"
                                            Visibility="{Binding HasJoin, Converter={StaticResource Visible}}" />
                                    <Button Content="Plan" Tag="{Binding Id}" Click="OnPlan" />
                                    <Button Content="Dismiss" Tag="{Binding Id}" Click="OnDismiss" />
                                    <Button x:Name="SnoozeButton" Tag="{Binding Id}" Click="OnSnooze" Loaded="OnSnoozeLoaded" />
                                    <Button Content="Open source" Tag="{Binding Id}" Click="OnOpen"
                                            Visibility="{Binding HasSource, Converter={StaticResource Visible}}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
