<Window x:Class="rNotice.Agent.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:rNotice.Agent"
        Title="rNotice" Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        BorderBrush="#2B6CB0" BorderThickness="2">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <Style x:Key="TaskButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="MinWidth" Value="72" />
        </Style>
        <Style x:Key="MeetingButton" TargetType="Button">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="0,0,12,10" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
        <Style x:Key="JoinButton" TargetType="Button" BasedOn="{StaticResource MeetingButton}">
            <Setter Property="Background" Value="#2B6CB0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#2B6CB0" />
        </Style>

        <!-- The one pop-up (P2.6): big, a live countdown, and the same buttons in the same places
             every time. A button that doesn't apply is greyed out, and its tooltip says why. -->
        <DataTemplate x:Key="PopupTemplate">
            <StackPanel Margin="0,4,0,18">
                <TextBlock Text="{Binding Countdown}" FontSize="40" FontWeight="SemiBold" Foreground="#2B6CB0" />
                <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding PopupLine}" FontSize="17" Opacity="0.8" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="{Binding WorkLine}" FontSize="17" Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding IsWorking, Converter={StaticResource Visible}}" />
                <WrapPanel Margin="0,24,0,0">
                    <Button Content="Join" Tag="{Binding Id}" Click="OnJoin" Style="{StaticResource JoinButton}"
                            IsEnabled="{Binding HasJoin}" ToolTip="{Binding JoinTip}" ToolTipService.ShowOnDisabled="True" />
                    <Button Content="Working on it" Tag="{Binding Id}" Click="OnStartWork" Style="{StaticResource MeetingButton}"
                            FontWeight="SemiBold" IsEnabled="{Binding CanStartWork}"
                            ToolTip="{Binding WorkTip}" ToolTipService.ShowOnDisabled="True" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,10" IsEnabled="{Binding IsWorking}"
                                ToolTip="{Binding KeepTip}" ToolTipService.ShowOnDisabled="True">
                        <ComboBox Tag="{Binding Id}" MinWidth="170" FontSize="15" VerticalContentAlignment="Center" Loaded="OnKeepLoaded" />
                        <Button Content="Still working" Tag="{Binding Id}" Click="OnKeepWorking" Style="{StaticResource MeetingButton}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                    <Button Content="Mark done" Tag="{Binding Id}" Click="OnDone" Style="{StaticResource MeetingButton}"
                            ToolTip="Done in rNotice" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,10" IsEnabled="{Binding CanRebook}"
                                ToolTip="{Binding RebookTip}" ToolTipService.ShowOnDisabled="True">
                        <ComboBox Tag="{Binding Id}" MinWidth="280" FontSize="15" VerticalContentAlignment="Center"
                                  Loaded="OnRebookLoaded" DropDownOpened="OnRebookOpened" />
                        <Button Content="Rebook" Tag="{Binding Id}" Click="OnRebookBook" Style="{StaticResource MeetingButton}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                    <Button Content="{Binding OpenLabel}" Tag="{Binding Id}" Click="OnOpen" Style="{StaticResource MeetingButton}"
                            IsEnabled="{Binding HasSource}" ToolTip="{Binding OpenTip}" ToolTipService.ShowOnDisabled="True" />
                    <Button Content="Follow up" Tag="{Binding Id}" Click="OnFollowUp" Style="{StaticResource MeetingButton}"
                            ToolTip="Plans a new 'Follow up - ...' a week on. This one is left as it is." />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel x:Name="Root" Margin="18,14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Close" Margin="0" Padding="12,4" Click="OnClose"
                    ToolTip="Leave these in the queue" />
            <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemsList" ItemTemplate="{StaticResource PopupTemplate}" />
        </ScrollViewer>
    </DockPanel>
</Window>
