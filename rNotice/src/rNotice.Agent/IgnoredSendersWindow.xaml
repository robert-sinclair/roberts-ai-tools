<Window x:Class="rNotice.Agent.IgnoredSendersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="rNotice — Ignored senders" Width="520" Height="520" MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

    <DockPanel Margin="18,14">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,10"
                   Text="Mail from these senders never reaches the queue. An entry is an address, or @domain.com for everyone at a domain." />

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Add" Padding="14,3" Margin="8,0,0,0" Click="OnAdd" />
            <TextBox x:Name="NewEntry" VerticalContentAlignment="Center" KeyDown="OnNewEntryKey"
                     ToolTip="name@example.com or @example.com" />
        </DockPanel>
        <TextBlock x:Name="Error" DockPanel.Dock="Top" Foreground="#D13438" TextWrapping="Wrap"
                   Margin="0,0,0,6" Visibility="Collapsed" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="Note" DockPanel.Dock="Left" Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                       VerticalAlignment="Center" MaxWidth="260"
                       Text="Taking a sender off re-reads the last few days of mail, so their recent messages come back." />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Padding="14,4" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Save" IsDefault="False" Padding="18,4" Click="OnSave" FontWeight="SemiBold" />
        </DockPanel>

        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Remove" VerticalAlignment="Top" Padding="12,3" Margin="8,0,0,0"
                    Click="OnRemove" ToolTip="Delete or Backspace also removes the selected entry" />
            <ListBox x:Name="Entries" SelectionMode="Extended" KeyDown="OnListKey" />
        </DockPanel>
    </DockPanel>
</Window>
