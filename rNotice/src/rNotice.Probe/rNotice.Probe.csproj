<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 10.0.19041 rather than plain net8.0-windows: the MSAL broker package needs the
         Windows SDK projection for WAM interop. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>rNotice.Probe</RootNamespace>
    <AssemblyName>rNotice.Probe</AssemblyName>
    <Version>0.1.0</Version>
    <Company>Bravura Security</Company>
    <Product>rNotice</Product>
    <AssemblyTitle>rNotice Probe</AssemblyTitle>
    <Description>Reports which Microsoft Graph permissions rNotice can actually use.</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the versions that resolved from 4.* on the first real build (2026-10-21). -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.91.1" />
    <PackageReference Include="Microsoft.Identity.Client.Broker" Version="4.91.1" />
  </ItemGroup>

</Project>
